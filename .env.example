# Deal Desk environment. Copy to .env.local and fill in. Never commit real secrets.

# ---- Database (Postgres). Unset = local customer/order archives. ------------
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- App ---------------------------------------------------------------------
# Public base URL, used for OAuth redirects. Defaults to http://localhost:3000
# APP_BASE_URL="http://localhost:3000"

# ---- Shopify (source of orders & customers) ----------------------------------
# Prefer a client app in the Shopify Dev Dashboard with OAuth; existing tokens are supported.
# Scopes needed: read_orders, read_customers.
# SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
# SHOPIFY_ADMIN_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# SHOPIFY_API_VERSION="2026-07"

# ---- QuickBooks Online (accounting / invoices) -------------------------------
# From an app at https://developer.intuit.com (Accounting scope).
# Redirect URI must be:  <APP_BASE_URL>/api/quickbooks/callback
# QBO_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# QBO_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# QBO_ENVIRONMENT="sandbox"   # or "production"
# QBO_REDIRECT_URI="http://localhost:3000/api/quickbooks/callback"

# ---- Optional AI drafts and notes/roadmap planning --------------------------
# COPILOT_PROVIDER="ollama"   # or "anthropic"
# OLLAMA_HOST="http://localhost:11434"
# OLLAMA_MODEL="gemma3:4b"
# ANTHROPIC_API_KEY="sk-ant-..."          # only if COPILOT_PROVIDER=anthropic
# COPILOT_MODEL="<your-supported-model>"

# ---- Google Ads (PPC: live CPC pull + campaign push) -------------------------
# From a Google Ads API developer token + an OAuth2 client with a refresh token.
# Customer id is digits only (no dashes). Login customer id = your MCC, if any.
# GOOGLE_ADS_DEVELOPER_TOKEN="xxxxxxxx"
# GOOGLE_ADS_CLIENT_ID="xxxx.apps.googleusercontent.com"
# GOOGLE_ADS_CLIENT_SECRET="xxxx"
# GOOGLE_ADS_REFRESH_TOKEN="1//xxxx"
# GOOGLE_ADS_CUSTOMER_ID="1234567890"
# GOOGLE_ADS_LOGIN_CUSTOMER_ID="1234567890"
# GOOGLE_ADS_API_VERSION="v25"

# ---- Amazon Selling Partner API (Amazon orders feed) -------------------------
# LWA app credentials + a refresh token for your seller account.
# Region: na | eu | fe. Marketplace id e.g. ATVPDKIKX0DER (amazon.com).
# AMAZON_SP_CLIENT_ID="amzn1.application-oa2-client.xxxx"
# AMAZON_SP_CLIENT_SECRET="xxxx"
# AMAZON_SP_REFRESH_TOKEN="Atzr|xxxx"
# AMAZON_SP_MARKETPLACE_ID="ATVPDKIKX0DER"
# AMAZON_SP_REGION="na"

# ---- Amazon Ads (separate approved app; Sponsored Products) ------------------
# Prefer the Amazon Ads connection wizard in Settings.
# AMAZON_ADS_CLIENT_ID="<approved-ads-app-client-id>"
# AMAZON_ADS_CLIENT_SECRET="<client-secret>"
# AMAZON_ADS_REFRESH_TOKEN="<authorized-advertising-refresh-token>"
# AMAZON_ADS_REGION="na"

# ---- Durable local workspace and owner gateway ------------------------------
# All local tracker, connection, visit, and submission data lives here.
# Back up this directory INCLUDING vault.key. Use a persistent private volume.
# DEALDESK_DATA_DIR="/absolute/path/to/private/shuug-data"
# Required behind an authenticated gateway in production. Inject server-side.
# WORKSPACE_ACCESS_TOKEN="<random-owner-token>"

# Most connection settings can be entered in the Settings wizard instead.
# SHOPIFY_CLIENT_ID="<app-client-id>"
# SHOPIFY_CLIENT_SECRET="<app-client-secret>"
# GOOGLE_MAPS_SERVER_KEY="<Places-and-Routes-key>"
# GOOGLE_MAPS_BROWSER_KEY="<HTTP-referrer-restricted-JavaScript-key>"
# GOOGLE_ADS_ENABLE_CAMPAIGN_PUSH="false"
# BRAVE_SEARCH_API_KEY="<optional-competitor-discovery-key>"
# ZAPIER_WEBHOOK_URL="https://hooks.zapier.com/hooks/catch/..."
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/TEAM/CHANNEL/SECRET"
# Slack and Stripe may also be configured in the encrypted Connections screen.
# Run npm run workflow:worker for enabled website-workflow external deliveries.
# CUSTOM_API_URL="https://your-api.example.com/events"
# CUSTOM_API_TOKEN="<optional-bearer-token>"

# ---- Stripe (credit-card / billing) -----------------------------------------
# From dashboard.stripe.com → Developers → API keys. Test key to start.
# STRIPE_SECRET_KEY="sk_test_xxxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxxx"   # signs /api/website/stripe/webhook; run website-payments:worker

# ---- Local encrypted database (optional, on-device) --------------------------
# Turn on to store ALL records in a single AES-256-GCM encrypted file on this
# computer — ciphertext at rest, unreadable without this passphrase. Off by
# default (nothing written to disk). Card numbers are NEVER stored here or
# anywhere in the app — Stripe hosts the card entry (see STRIPE_SECRET_KEY).
# LOCAL_DB_PASSPHRASE="a-long-passphrase-only-you-know"
# LOCAL_DB_PATH="~/.shuug/data.enc"

# --- ADP Payroll (Workforce Now) ---
# OAuth2 client-credentials over mutual TLS. Team → ADP worker sync.
ADP_CLIENT_ID=
ADP_CLIENT_SECRET=
ADP_CERT_PEM=
ADP_KEY_PEM=
ADP_HOST=api.adp.com

# ---- Optional backend / MCP / Shopify commerce connector -------------------
# Node 22.13+ required. Run npm run backend:setup for a generated local token.
# BACKEND_ACCESS_TOKEN="<private-backend-bearer-token>"
# SHUUG_BACKEND_URL="http://127.0.0.1:3000" # for the stdio MCP client
# SHUUG_BACKEND_TOKEN="<remote-backend-token>" # optional override for stdio
# SHOPIFY_BACKEND_ENABLED="false" # no store is required for the business app
# SHOPIFY_WRITE_ENABLED="false"   # explicit product/inventory write permission
# The connection wizard stores the app credentials and rotating tokens securely.
# SHOPIFY_CLIENT_ID="<client-app-id>"
# SHOPIFY_CLIENT_SECRET="<client-app-secret>"

# Example records are opt-in in new sales, operations, tasks and mail workspaces.
DEMO_DATA=false
# Require owner sign-in during development too (always required in production).
# AUTH_ENABLED=true

# --- Documents & legal ---
# E-signature (set ONE provider). DocuSign:
DOCUSIGN_ACCESS_TOKEN=
DOCUSIGN_ACCOUNT_ID=
# ...or PandaDoc:
PANDADOC_API_KEY=
PANDADOC_WORKSPACE=
# LegalZoom (entity/filing/compliance data + services):
LEGALZOOM_API_KEY=

# --- Integrations hub (fail-closed connectors; add to connect) ---
# GoDaddy (domains, DNS, email — developer.godaddy.com/keys):
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_ENVIRONMENT=          # blank = production, "ote" = test
# Mailchimp (email marketing):
MAILCHIMP_API_KEY=
# Twilio (SMS to customers):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# PayPal:
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Square:
SQUARE_ACCESS_TOKEN=
# Google Business Profile:
GOOGLE_BUSINESS_ACCESS_TOKEN=
# Meta (Facebook & Instagram):
META_PAGE_ACCESS_TOKEN=
# Mailgun / transactional email:
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Xero (alternative accounting):
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
